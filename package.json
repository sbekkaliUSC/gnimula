{
  "name": "gnimula",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "api:dev": "wrangler dev --port 8790",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  }
}
